HOST=0.0.0.0
PORT=1338
# Where people reach Strapi: the links in its emails, and the Google login's
# redirect URI (PUBLIC_URL/google-login/callback). In production, e.g.
# https://strapi.efektiivnealtruism.org.
# PUBLIC_URL=http://localhost:1338

# The public site. Allowed to call this API from the browser (contact form)
# and to be framed by the content manager's preview panel.
FRONTEND_URL=http://localhost:3003

# Extra browser origins allowed to call the content API, comma-separated.
# Leave unset unless you need it.
# CORS_ORIGINS=

# Trust X-Forwarded-For for the client's address, and X-Forwarded-Proto for
# HTTPS. Turn this on ONLY when the proxy in front of this app overwrites that
# header with the real peer address rather than appending to it — otherwise a
# client can name any address it likes and pick its own rate-limit bucket.
# Required in production (NODE_ENV=production): Strapi won't start without it.
# SERVER_PROXY=true

# Rate limits skip loopback and private addresses, which stand for many
# visitors at once: the reverse proxy, and the site's server, which fetches
# content and proxies /uploads. Name the site's network here when it's outside
# the private ranges (comma-separated, address/prefix).
# INTERNAL_NETWORKS=172.32.0.0/24

# Generate each with: openssl rand -base64 16
# (APP_KEYS takes four, comma-separated)
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
# Lets API tokens be viewed again in the admin after creation.
ENCRYPTION_KEY=tobemodified

# Called after every content change so the frontend drops its cached pages.
# REVALIDATE_SECRET must match the frontend's. Generate with:
# openssl rand -hex 32
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3003/api/revalidate
REVALIDATE_SECRET=tobemodified

# Enables the "Preview" button in the content manager. Must match the
# frontend's PREVIEW_SECRET. Generate with: openssl rand -hex 32
PREVIEW_SECRET=tobemodified

# Admin login with Google (see the README). With both set, passwords are
# turned off; without them, everyone logs in with a password.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The Workspace whose accounts may log in; this is the default.
# GOOGLE_WORKSPACE_DOMAIN=efektiivnealtruism.org

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=efektiivnealtruism
# Homebrew's and Postgres.app's Postgres let your own user in without a
# password: put your macOS username here and leave the password empty.
DATABASE_USERNAME=tobemodified
DATABASE_PASSWORD=
DATABASE_SSL=false

# Email (any SMTP service; Brevo's free plan is enough). Can stay empty
# locally: contact form messages are still saved, just not sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=
