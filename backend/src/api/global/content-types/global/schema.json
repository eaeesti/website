{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Navbar, footer and other settings shared by every page."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "metadata": {
      "type": "component",
      "repeatable": false,
      "component": "meta.metadata",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "appleTouchIcon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "navbar": {
      "type": "component",
      "repeatable": false,
      "component": "meta.navbar",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footer": {
      "type": "component",
      "repeatable": false,
      "component": "meta.footer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notFoundPage": {
      "type": "component",
      "repeatable": false,
      "component": "meta.not-found-page",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topBannerText": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "dateLocale": {
      "type": "enumeration",
      "enum": ["et-EE", "en-GB"],
      "default": "et-EE",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "languageSwitchText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "closeText": {
      "type": "string",
      "default": "Close",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "errorText": {
      "type": "string",
      "default": "Something went wrong",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "emailCopiedText": {
      "type": "string",
      "default": "Email address copied!",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "previousPageText": {
      "type": "string",
      "default": "Previous",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nextPageText": {
      "type": "string",
      "default": "Next",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blogTitle": {
      "type": "string",
      "default": "Blog",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relatedPostsTitle": {
      "type": "string",
      "default": "Read more",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "previewText": {
      "type": "string",
      "default": "Preview: you're seeing unpublished changes.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "exitPreviewText": {
      "type": "string",
      "default": "Exit preview",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
