{
  "name": "efektiivnealtruism-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Strapi backend for the Efektiivne Altruism Eesti website",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "generate-types": "node ../scripts/generate-strapi-types.mjs",
    "build": "node ../scripts/generate-strapi-types.mjs && rm -rf dist && strapi build",
    "dev": "node ../scripts/generate-strapi-types.mjs && strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "snapshot:make": "node --env-file=.env scripts/content-snapshot.mjs make",
    "snapshot:load": "node --env-file=.env scripts/content-snapshot.mjs load"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "5.62.0",
    "@strapi/provider-email-nodemailer": "5.62.0",
    "@strapi/strapi": "5.62.0",
    "koa2-ratelimit": "^1.1.3",
    "pg": "8.23.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.28.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@strapi/typescript-utils": "5.62.0",
    "@types/koa": "^2.15.0",
    "@types/node": "^25.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
