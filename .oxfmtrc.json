{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "./frontend/src/app/globals.css",
    "functions": ["classes", "buttonClasses"]
  },
  "ignorePatterns": [
    "backend/types/generated/**",
    "frontend/src/types/generated/**",
    "backend/public/**",
    "e2e/.state/**",
    "frontend/public/js/plausible-*-[0-9]*.js",
    "frontend/public/js/umami-[0-9]*.js"
  ]
}
