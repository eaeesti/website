# Server-only. Must NOT be prefixed NEXT_PUBLIC_, which would inline the token
# into the browser bundle. Created by the Strapi bootstrap (written here
# automatically in development; in production view it in Strapi under
# Settings → API Tokens).
STRAPI_API_TOKEN=your-api-token

# Where the Next.js server reaches Strapi. On the server this is loopback, so
# page renders never leave the machine.
STRAPI_URL=http://127.0.0.1:1337

# Where browsers reach Strapi (the contact form posts here).
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the backend's REVALIDATE_SECRET and PREVIEW_SECRET.
REVALIDATE_SECRET=
PREVIEW_SECRET=

# Optional: Plausible analytics domain, e.g. efektiivnealtruism.org
PLAUSIBLE_DOMAIN=

# Where the donation form sends donations: Anneta Targalt's external donation
# endpoint. Production is the default. It only accepts return URLs on the
# organisation's own domains, so donations started from localhost are refused.
# NEXT_PUBLIC_DONATION_API_URL=https://strapi.annetatargalt.ee/api/donateExternal
